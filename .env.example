# Copy to .env.local for local development. Never commit .env.local.

# Neon Postgres. Locally either the direct or pooled string works; on Vercel
# use the POOLED connection string (the "-pooler" host).
DATABASE_URL=

# Existing scanner keys (already configured in Vercel for production).
GOOGLE_PLACES_API_KEY=
GOOGLE_PSI_API_KEY=
YELP_API_KEY=

# Rooftop solar signal (deep scan + scripts/solar.mjs). Server-side only.
# The Static Maps API must be enabled on whichever Google key is used; leave
# GOOGLE_STATIC_MAPS_API_KEY empty to reuse GOOGLE_PLACES_API_KEY.
GOOGLE_STATIC_MAPS_API_KEY=
ANTHROPIC_API_KEY=
# Optional override of the vision model (default claude-opus-5).
SOLAR_VISION_MODEL=
# Set to 1 to let tests/solarSignal.test.mjs spend real requests on the six
# known-roof sample coordinates.
SOLAR_LIVE_TEST=

# Public contact email used on Privacy/Terms/footer. Leave unset until a real inbox exists.
NEXT_PUBLIC_CONTACT_EMAIL=

# Stripe Checkout for the /cleanup page. Server-only — never expose these to
# the client. Use test-mode keys (sk_test_..., whsec_...) until verified.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SANDBOX=
STRIPE_PRICE_FULL=

# Fulfillment-partner referral plumbing (private prospecting layer only).
# All partner specifics live here — never hardcode them in src/ or scripts/
# (the public-leak tests enforce partner-agnostic code).
PARTNER_NAME=
PARTNER_FORM_URL=
PARTNER_AM_ID=
